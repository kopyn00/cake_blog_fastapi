cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo

# Database
*.db
*.sqlite3

# Virtual environment
.venv/
venv/

# Environment variables
.env
.env.*
!.env.example

# Media and uploads
populate_images/
media/profile_pics/*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Scripts
populate_db.py

EOF